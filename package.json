{
  "name": "pi-desk",
  "version": "0.1.0",
  "description": "A desktop workspace for Pi coding agent sessions.",
  "author": {
    "name": "TCcodecode",
    "email": "pi-desk@users.noreply.github.com"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "electron-vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.74.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@pi-desk/code-index": "*",
    "@pi-desk/mcp-bridge": "*",
    "@pi-desk/session-todo": "*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^4.0.0",
    "lucide-react": "^1.30.0",
    "pi-mcp-adapter": "^2.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.tccodecode.pidesk",
    "productName": "Pi Desk",
    "artifactName": "PiDesk-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "TCcodecode",
        "repo": "pi-desk"
      }
    ],
    "asar": true,
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Pi Desk",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  }
}
